---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate } from '../lib/content';
interface Props { essays: CollectionEntry<'essays'>[]; empty?: string }
const { essays, empty = 'Essays coming soon.' } = Astro.props;
---
{essays.length === 0 ? (
  <p class="empty">{empty}</p>
) : (
  <ul class="list">
    {essays.map((e) => (
      <li>
        <a class="title" href={url(`essays/${e.id}`)}>{e.data.title}</a>
        <div class="meta"><time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time></div>
        <p>{e.data.description}</p>
      </li>
    ))}
  </ul>
)}
